# Copy to deploy/.env on the server. See server/.env.example for every option.
DOMAIN=app.yourdomain.com
APP_URL=https://app.yourdomain.com
API_URL=https://app.yourdomain.com
SECRET_KEY=            # openssl rand -hex 32  — keep it forever; it encrypts Google tokens
CRAWLER_USER_AGENT=IndexoraBot/1.0 (+https://app.yourdomain.com/bot)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Indexora <alerts@yourdomain.com>

LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CHECKOUT_URLS={}
LEMONSQUEEZY_VARIANT_PLANS={}  # e.g. {"101":"starter","102":"starter:founding","201":"pro","202":"pro:founding"}
LEMONSQUEEZY_PORTAL_URL=

# Optional: backlink discovery provider (turn on once you have paying Pro users)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Core Web Vitals (real-user data from the Chrome UX Report). Free Google API key with "Chrome UX Report API" enabled.
CRUX_API_KEY=

# Litestream backups (Cloudflare R2 example)
LITESTREAM_BUCKET=indexora-backups
LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Days of the no-card Pro trial every new account starts with (0 = no trial)
TRIAL_DAYS=14
