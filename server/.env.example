# Copy to .env and fill in. Everything is optional for local development.
PORT=8787
# Where the SQLite database lives
DATABASE_PATH=./data/indexora.db
# Public URL of the web app (used for CORS, OAuth redirects and links in emails)
APP_URL=http://localhost:5173
# Public URL of this API
API_URL=http://localhost:8787
# 32-byte key for encrypting Google tokens: openssl rand -hex 32
SECRET_KEY=
# Set to "true" behind HTTPS so session cookies are marked Secure
COOKIE_SECURE=false
# User-Agent our crawler identifies itself with
CRAWLER_USER_AGENT=IndexoraBot/0.1 (+https://indexora.app/bot)
# Run background jobs in this process (disable if you run a separate worker)
RUN_WORKER=true

# Google Search Console (OAuth "Web application" client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backlink discovery provider (optional). Without it, backlinks come from
# manual adds and Search Console CSV imports, and are still verified daily.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Notifications
SLACK_WEBHOOK_URL=
SMTP_URL=
MAIL_FROM=Indexora <alerts@indexora.app>

# Billing — Lemon Squeezy (merchant of record: handles VAT/sales tax and pays out to
# sellers in Turkey, which Stripe does not support). See docs/PRICING.md.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Hosted checkout links per plan/cycle; "_founding" variants carry the locked-in launch price
LEMONSQUEEZY_CHECKOUT_URLS={"starter_monthly":"","starter_yearly":"","pro_monthly":"","pro_yearly":"","agency_monthly":"","agency_yearly":"","starter_monthly_founding":"","pro_monthly_founding":"","agency_monthly_founding":""}
# Variant id -> plan, used when webhooks arrive
LEMONSQUEEZY_VARIANT_PLANS={}
LEMONSQUEEZY_PORTAL_URL=
